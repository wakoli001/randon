    private static GameResult playRound() {

        Category category = chooseCategory();

        String secretWord = category.getRandomWord();



        Set<Character> guessedLetters = new HashSet<>();

        int wrongGuesses = 0;



        System.out.println("\n--------------------------------------");

        System.out.println("Category: " + category.getName());

        System.out.println("The word has " + secretWord.length() + " letters.");



        while (wrongGuesses < MAX_WRONG_GUESSES) {

            printRoundStatus(secretWord, guessedLetters, wrongGuesses);



            char guess = readLetter(guessedLetters);

            guessedLetters.add(guess);



            if (secretWord.indexOf(guess) >= 0) {

                System.out.println("Correct! The letter '" + guess + "' is in the word.");

            } else {

                wrongGuesses++;

                System.out.println("Sorry, '" + guess + "' is not in the word.");

            }



            if (hasGuessedWord(secretWord, guessedLetters)) {

                return new GameResult(true, secretWord, wrongGuesses);

            }

        }



        return new GameResult(false, secretWord, wrongGuesses);

    }



