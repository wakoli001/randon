    private static String makeHiddenWord(

        String secretWord,

        Set<Character> guessedLetters

    ) {

        StringBuilder display = new StringBuilder();



        for (int i = 0; i < secretWord.length(); i++) {

            char letter = secretWord.charAt(i);



            if (guessedLetters.contains(letter)) {

                display.append(letter);

            } else {

                display.append('_');

            }



            if (i < secretWord.length() - 1) {

                display.append(' ');

            }

        }



        return display.toString();

    }



    private static String formatGuessedLetters(Set<Character> guessedLetters) {

        if (guessedLetters.isEmpty()) {

            return "none";

        }



        List<Character> sortedLetters = new ArrayList<>(guessedLetters);

        Collections.sort(sortedLetters);



        StringBuilder formatted = new StringBuilder();



        for (int i = 0; i < sortedLetters.size(); i++) {

            formatted.append(sortedLetters.get(i));



            if (i < sortedLetters.size() - 1) {

                formatted.append(", ");

            }

        }



        return formatted.toString();

    }



    private static char readLetter(Set<Character> guessedLetters) {

        while (true) {

            System.out.print("Enter one letter: ");

            String input = INPUT.nextLine().trim().toLowerCase();



            if (input.length() != 1) {

                System.out.println("Please enter exactly one character.");

                continue;

            }



            char letter = input.charAt(0);



            if (!Character.isLetter(letter)) {

                System.out.println("Please enter a letter, not a number or symbol.");

                continue;

            }



            if (guessedLetters.contains(letter)) {

                System.out.println("You already guessed that letter.");

                continue;

            }



            return letter;

        }

    }



    private static boolean hasGuessedWord(

        String secretWord,

        Set<Character> guessedLetters

    ) {

        for (int i = 0; i < secretWord.length(); i++) {

            if (!guessedLetters.contains(secretWord.charAt(i))) {

                return false;

            }

        }



        return true;

    }



